{
  "name": "ha-weather-heatmap-card",
  "version": "2026.11.26-beta.1",
  "description": "A Home Assistant Lovelace card displaying temperature or wind speed history as a color-coded heatmap",
  "type": "module",
  "main": "dist/ha-weather-heatmap-card.js",
  "scripts": {
    "prebuild": "node scripts/audit-gate.js",
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "test": "tests/run-capped.sh node --test --test-timeout=10000 --test-concurrency=1 tests/",
    "coverage": "tests/run-capped.sh node --test --test-timeout=10000 --test-concurrency=1 --experimental-test-coverage --test-coverage-include='src/**' tests/"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "temperature",
    "wind-speed",
    "heatmap",
    "weather"
  ],
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "happy-dom": "^21.0.4",
    "rollup": "^4.60.1"
  }
}
